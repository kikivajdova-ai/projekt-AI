{
  "name": "odpocivat-spolu-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend wellbeing aplikace Odpočívat spolu (Supabase + Drizzle ORM)",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate && tsx scripts/vytvor-migrace.ts",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "functions:serve": "supabase functions serve --env-file ./supabase/functions/.env"
  },
  "dependencies": {
    "drizzle-orm": "0.44.7",
    "hono": "4.10.4",
    "jose": "6.1.0",
    "postgres": "3.4.7",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "9.38.0",
    "@types/node": "22.18.12",
    "drizzle-kit": "0.31.6",
    "eslint": "9.38.0",
    "prettier": "3.6.2",
    "supabase": "2.54.11",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2"
  }
}
