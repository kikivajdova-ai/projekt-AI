# Proměnné pro Edge Functions. Zkopíruj jako .env (ten se do Gitu NEcommituje)
# a pro produkci je nastav příkazem: supabase secrets set --env-file ./supabase/functions/.env
#
# SUPABASE_URL a SUPABASE_SERVICE_ROLE_KEY dodává Supabase do Edge Functions sám.

# Připojení k databázi jako app_api (NE postgres). Heslo nastavíš podle README.
# Pooler v režimu transakcí (port 6543); uživatel ve tvaru app_api.<id-projektu>
APP_DB_URL=postgresql://app_api.<id-projektu>:<heslo>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Náhodný řetězec aspoň 32 znaků (např. `openssl rand -base64 48`)
SHARE_PREVIEW_SECRET=
# Tajemství pro plánovač, který volá funkci dispatch
CRON_SECRET=

# Kam vedou pozvánkové odkazy (deep link do aplikace)
APP_INVITE_BASE_URL=https://odpocivatspolu.cz/pozvanka

# Interní systém podpory (webhook), kam chodí nahlášení
SUPPORT_WEBHOOK_URL=
SUPPORT_WEBHOOK_SECRET=

# Firebase Cloud Messaging: obsah JSON klíče servisního účtu (jeden řádek)
FCM_SERVICE_ACCOUNT_JSON=

# Jen pokud bude webová verze: povolená doména pro CORS
ALLOWED_ORIGIN=
